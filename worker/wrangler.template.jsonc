// worker/make-config.mjs copies this to worker/wrangler.jsonc (git-ignored) with the D1 id filled in:
// the real id in release/workflows/worker.yml, a placeholder for CI's dry-run and local migrations.
{
  "name": "thuammai-alerts",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // No invocation logs: they would hold request metadata we promise not to keep (spec §4, §8).
  "observability": { "enabled": false },
  "vars": {
    "SITE_ORIGIN": "https://thaiglider.github.io",
    "SITE_URL": "https://thaiglider.github.io/thuammai/"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "thuammai-alerts", "database_id": "__D1_DATABASE_ID__", "migrations_dir": "migrations" }
  ],
  // 03:00 Bangkok: cleanup + capacity totals (spec §4 "Cron")
  "triggers": { "crons": ["0 20 * * *"] }
}
