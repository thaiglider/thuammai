# $THUAMMAI_HOME/.env — settings that are not secret (spec §7.1). Written by `thuammai install`, mode 0600.
THUAMMAI_HOME=/home/deploy/thuammai
THUAMMAI_UID=1000
THUAMMAI_GID=1000
IMAGE_TAG=
# Our own tag of the Postgres image the db runs (thuammai-db:<id12>); set by install and update.sh --base.
DB_IMAGE=
API_HOST=flood-api.thaiglider.com
# SITE_ORIGIN: comma-separated origins allowed to call the API from a browser (CORS).
SITE_ORIGIN=https://flood.thaiglider.com
# SITE_URL: where the data files are fetched from. PUBLIC_URL: the link written in bot messages (https, ends with /; the API host redirects / to it).
SITE_URL=https://flood.thaiglider.com/
PUBLIC_URL=https://flood.thaiglider.com/
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=https://flood.thaiglider.com/
TELEGRAM_BOT_USERNAME=
ALERTS_PAUSED=0
# thuammai line off|on (Plan G, G-5): 1 = LINE answers "ปิดชั่วคราว", no LINE alerts.
LINE_OFF=0
# Plan J (H4): 0 = no trend alerts ("water starting to fall / rising again / rising fast"); default on.
TREND_ALERTS=1
# Stale-source watch: 0 = no Telegram notice to the admin when a water source is stale >6 h or the BMA relay fails.
SOURCE_WATCH=1
# Plan O: 0 = no 7-day chart photo after a Telegram alert/answer (the detail text still goes); default on.
TG_CHARTS=1
PROXY_NETWORK=ai-stack_ai-stack
TRUSTED_PROXY_HOST=caddy
CLIENT_IP_MODE=direct
# Set when the shared Caddy proves domains by DNS-01 per zone (e.g. its firewall admits only
# Cloudflare): thuammai caddy add then writes tls { dns <this> } into our block.
CADDY_TLS_DNS=
FINISHED=0
