# $THUAMMAI_HOME/.env — settings that are not secret (spec §7.1). Written by `thuammai install`, mode 0600.
THUAMMAI_HOME=/home/deploy/thuammai
THUAMMAI_UID=1000
THUAMMAI_GID=1000
IMAGE_TAG=
# Our own tag of the Postgres image the db runs (thuammai-db:<id12>); set by install and update.sh --base.
DB_IMAGE=
API_HOST=flood.thaiglider.com
# SITE_ORIGIN: comma-separated origins allowed to call the API from a browser (CORS).
SITE_ORIGIN=https://thaiglider.github.io
# SITE_URL: where the data files are fetched from. PUBLIC_URL: the link written in bot messages (empty = SITE_URL).
SITE_URL=https://thaiglider.github.io/thuammai/
PUBLIC_URL=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=https://flood.thaiglider.com/
TELEGRAM_BOT_USERNAME=
ALERTS_PAUSED=0
# thuammai line off|on (Plan G, G-5): 1 = LINE answers "ปิดชั่วคราว", no LINE alerts.
LINE_OFF=0
PROXY_NETWORK=ai-stack_ai-stack
TRUSTED_PROXY_HOST=caddy
CLIENT_IP_MODE=direct
# Set when the shared Caddy proves domains by DNS-01 per zone (e.g. its firewall admits only
# Cloudflare): thuammai caddy add then writes tls { dns <this> } into our block.
CADDY_TLS_DNS=
FINISHED=0
